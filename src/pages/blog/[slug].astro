---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout>
  <header class="post-header">
    <h1>{post.data.title}</h1>
  </header>

  <div class="post-layout">
    <article class="post-content">
      <Content />
    </article>

    <aside class="post-toc" aria-label="Содержание поста">
      <h2>Содержание</h2>
      <nav>
        <ul id="toc-list"></ul>
      </nav>
    </aside>
  </div>

  <script type="module">
    const tocList = document.getElementById('toc-list');
    if (tocList) {
      const headings = Array.from(document.querySelectorAll('.post-content h2, .post-content h3'));
      headings.forEach((heading) => {
        if (!heading.id) {
          heading.id = heading.textContent.trim().toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-_]/g, '');
        }
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        item.appendChild(link);
        tocList.appendChild(item);
      });
    }
  </script>
</BaseLayout>
