---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { sortCollectionByDateDesc } from "../../utils/sortCollectionByDateDesc";

const projects = sortCollectionByDateDesc(await getCollection("projects"));
---

<BaseLayout>
  <section class="first-section">
    <h1 class="h1 small-gap">Портфолио</h1>
    <p class="subheader">Здесь собраны мои проекты в области дизайна, иллюстрации и анимации</p>
  </section>

  <div class="portfolio-grid container">
    {projects.map(project => (
      <ProjectCard
        title={project.data.title}
        slug={project.id}
        cover={project.data.cover}
        description={project.data.description}
      />
    ))}
  </div>
</BaseLayout>
