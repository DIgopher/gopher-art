---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCardWide from "../../components/ProjectCardWide.astro";
import { getCollection } from "astro:content";
import { sortCollectionByDateDesc } from "../../utils/sortCollectionByDateDesc";

const projects = sortCollectionByDateDesc(await getCollection("projects"));

const sortedProjects = projects.toSorted((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout>
  <section class="first-section">
    <h1 class="h1 small-gap text-center">Портфолио</h1>
    <p class="subheader text-center">
      Здесь собраны мои проекты в области дизайна, иллюстрации и анимации
    </p>
  </section>

  <div class="grid container">
    <div class="portfolio-full">
      {
        sortedProjects.map((project) => (
          <ProjectCardWide
            title={project.data.title}
            slug={project.id}
            cover={project.data.cover}
            description={project.data.description}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
