---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { promises as fs } from "fs";
import path from "path";

const comicsRoot = path.join(process.cwd(), "public", "comics");
const comicDirs = await fs.readdir(comicsRoot, { withFileTypes: true });

const comics = [];
for (const dir of comicDirs) {
  if (!dir.isDirectory()) continue;
  const comic = dir.name;
  const chapterDirs = await fs.readdir(path.join(comicsRoot, comic), { withFileTypes: true });
  const chapters = chapterDirs
    .filter((d) => d.isDirectory())
    .map((d) => d.name)
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }));
  comics.push({ comic, chapters });
}
---

<BaseLayout>
  <header class="comic-header">
    <h1>Комиксы</h1>
    <p class="comic-header__subtitle">Выберите комикс и главу для чтения</p>
  </header>

  <section class="comic-index">
    {comics.length === 0 ? (
      <p>Нет доступных комиксов. Добавьте папки в <code>public/comics</code>.</p>
    ) : (
      <div class="comic-list">
        {comics.map(({ comic, chapters }) => (
          <article class="comic-card" key={comic}>
            <h2>{comic.replace(/[-_]/g, " ")}</h2>
            <p class="comic-card__hint">Выберите главу:</p>
            <ul class="comic-card__chapters">
              {chapters.map((chapter) => (
                <li key={chapter}>
                  <a href={`${import.meta.env.BASE_URL}comic/${encodeURIComponent(comic)}/${encodeURIComponent(chapter)}`}>
                    {chapter.replace(/[-_]/g, " ")}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
