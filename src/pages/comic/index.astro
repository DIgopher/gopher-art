---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ComicChapterCard from "../../components/ComicChapterCard.astro";
import { getCollection } from "astro:content";

const comics = await getCollection("comics");
const chapters = await getCollection("comicChapters");

const comicsWithChapters = comics
  .sort((a, b) => a.data.order - b.data.order)
  .map((comic) => {
    const comicChapters = chapters
      .filter((chapter) => chapter.data.comic === comic.data.slug)
      .sort((a, b) => a.data.order - b.data.order);

    return {
      ...comic,
      chapters: comicChapters,
    };
  });
---

<BaseLayout>
  <header class="first-section">
    <h1 class="h1 small-gap">Комиксы</h1>
    <p class="subheader">Выберите комикс и главу для чтения</p>
  </header>

  <section class="comic-index container">
    <div class="comic-list">
      {
        comicsWithChapters.map((comic) => (
          <article class="comic-card">
            <h2 class="h1 small-gap">{comic.data.title}</h2>

            {comic.data.description && (
              <p class="subheader gap">{comic.data.description}</p>
            )}

            <div class="comic-chapters">
              {comic.chapters.map((chapter) => (
                <ComicChapterCard
                  comic={comic.data.slug}
                  chapter={chapter.data.slug}
                  label={chapter.data.title}
                  description={chapter.data.description}
                  preview={chapter.data.preview}
                />
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
