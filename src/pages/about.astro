---
import BaseLayout from "../layouts/BaseLayout.astro";
import Expirience from "../components/Expirience.astro";
---

<BaseLayout>
  <section class="hero-section grid">
    <div class="text-title">
      <h1 class="title-header small-gap">Обо мне</h1>
      <p class="subheader">
        Меня зовут Оля Смирнова и я коммуникационный дизайнер с 2021 года.
        Занималась как научной иллюстрацией, так и дизайном коммуникаций в IT.
      </p>
    </div>
    <div class="hero-image">
      <img
        class="border-radius"
        src={`${import.meta.env.BASE_URL}me.webp`}
        alt="Logo"
      />
    </div>
  </section>
  <section class="container grid">
    <h2 class="h1 about-header">Образование</h2>
    <div class="cols4 gap">
      <Expirience
        time="2018-2022"
        place="Московский государственный университет им. М.В. Ломоносова"
        details="Бакалавриат - Биологический факультет - Эмбриология"
      />
      <Expirience
        time="2022-2024"
        place="Первый московский государственный университет им. И.М. Сеченова"
        details="Магистратура - Синтетическая биология и биодизайн"
      />
    </div>
    <h2 class="h1 about-header">Опыт работы</h2>
    <div class="cols4">
      <Expirience
        time="2020 - 2022"
        place="Студенческий комитет биологического факультета МГУ"
        details="Оформление группы и вывесок в общежитии"
      />
      <Expirience
        time="2023 - 2024"
        place="Институт регенративной медицины, МГМУ им. И.М. Сеченова"
        details="Дизайн презентаций, научная иллюстрация, дизайн сертификатов, постеров, оформление группы вк"
      />
      <Expirience
        time="2024 - н.в."
        place="Smart Engines"
        details="Дизайн сайта, приложения, постов в соц. сетях, дизайн презентаций, 3D-дизайн, анимация, полиграфические материалы, дизайн для выставок"
      />
    </div>
  </section>
</BaseLayout>
