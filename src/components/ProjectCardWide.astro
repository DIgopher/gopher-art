---
const { title, slug, cover, description } = Astro.props;
---

<a
  href={`${import.meta.env.BASE_URL}portfolio/${slug}/`}
  class="project-card blog-card-hover"
>
  <article class="card--wide">
    {cover && <img src={cover.src} alt={title} class="card-image--wide" />}
    <div class="card-overlay--wide">
      <h3 class="card-title--wide weight-400 uppercase">{title}</h3>
      {
        description && (
          <p class="card-description--wide p grey">{description}</p>
        )
      }
    </div>
  </article>
</a>

<style>
  /* Стили самой карточки */
  .blog-card-hover {
    cursor: none; /* Скрываем стандартный курсор при наведении */
    display: block; /* чтобы ссылка вела себя как блочный элемент */
    transform: translateZ(0);
    will-change: transform;
  }

  @media (max-width: 860px) {
    .blog-card-hover {
      cursor: pointer;
    }
  }
  /* .blog-card-hover,
  .blog-card-hover * {
    cursor:
      url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="),
      none !important;

    
    -webkit-user-select: none;
    user-select: none;
  } */
</style>

<script>
  let cursor = document.querySelector(".global-custom-cursor");

  if (!cursor) {
    cursor = document.createElement("div");
    cursor.classList.add("global-custom-cursor");
    cursor.textContent = "Смотреть\nпроект";
    document.body.appendChild(cursor);

    // Координаты мыши
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;

    // Предыдущие координаты (для вычисления скорости)
    let lastX = mouseX;
    let lastY = mouseY;

    // Текущий динамический масштаб (для плавности)
    let currentSpeedScale = 1;

    document.addEventListener("mousemove", (e) => {
      // 🛑 ПРОВЕРКА РАЗРЕШЕНИЯ ЭКРАНА
      // Если ширина окна 860px или меньше - прерываем выполнение функции
      if (window.innerWidth <= 860) {
        image.style.transform = "none"; // Сбрасываем трансформацию на всякий случай
        return;
      }
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    // Бесконечный цикл отрисовки
    function render() {
      // 1. Вычисляем пройденное расстояние между текущим и прошлым кадром
      const dx = mouseX - lastX;
      const dy = mouseY - lastY;
      const distance = Math.sqrt(dx * dx + dy * dy);

      // 2. Настраиваем чувствительность (чем выше maxDist, тем сильнее нужно дернуть мышью)
      const maxDist = 80;
      const clampedDist = Math.min(distance, maxDist);

      // 3. Вычисляем целевой масштаб: 1 (в покое) -> 0.5 (при максимальной скорости)
      const targetScale = 1 - (clampedDist / maxDist) * 0.3;

      // 4. Плавная интерполяция (Lerp), чтобы круг не "прыгал" в размерах, а сжимался мягко
      currentSpeedScale += (targetScale - currentSpeedScale) * 0.15;

      // 5. Применяем координаты и передаем масштаб в CSS-переменную
      cursor.style.left = `${mouseX}px`;
      cursor.style.top = `${mouseY}px`;
      cursor.style.setProperty("--speed-scale", currentSpeedScale.toString());

      // Сохраняем текущие координаты для следующего кадра
      lastX = mouseX;
      lastY = mouseY;

      requestAnimationFrame(render);
    }

    // Запускаем цикл
    requestAnimationFrame(render);
  }

  // Логика наведения (остается без изменений)
  const cards = document.querySelectorAll(".blog-card-hover");
  cards.forEach((card) => {
    card.addEventListener("mouseenter", () => {
      if (window.innerWidth <= 860) return;
      cursor.classList.add("active");
    });
    card.addEventListener("mouseleave", () => {
      if (window.innerWidth <= 860) return;
      cursor.classList.remove("active");
    });
  });

  // Логика 3D-вращения картинки

  cards.forEach((card) => {
    const image = card.querySelector(".card-image--wide");

    // Если картинки нет, пропускаем
    if (!image) return;

    card.addEventListener("mousemove", (e) => {
      // 🛑 ПРОВЕРКА РАЗРЕШЕНИЯ ЭКРАНА
      // Если ширина окна 860px или меньше - прерываем выполнение функции
      if (window.innerWidth <= 860) {
        image.style.transform = "none"; // Сбрасываем трансформацию на всякий случай
        return;
      }
      // 1. Получаем размеры и позицию карточки
      const rect = card.getBoundingClientRect();

      // 2. Вычисляем позицию мыши внутри карточки (от 0 до ширины/высоты)
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      // 3. Находим центр карточки
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      // 4. Вычисляем градус наклона.
      // Делим на centerX/Y чтобы получить значения от -1 до 1,
      // и умножаем на максимальный градус (например, 10 или 15)
      const maxTilt = 3; // Максимальный угол наклона в градусах

      // По оси X крутим вверх/вниз (зависит от Y курсора)
      // По оси Y крутим влево/вправо (зависит от X курсора)
      const rotateX = ((centerY - y) / centerY) * maxTilt;
      const rotateY = ((x - centerX) / centerX) * maxTilt;

      // 5. Применяем трансформацию (убираем transition для мгновенного следования за мышью)
      image.style.transition = "transform 0.15s ease-out";
      // Немного увеличиваем картинку scale(1.05), чтобы при повороте не было видно пустых краев
      image.style.transform = `scale(1.02) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });

    card.addEventListener("mouseleave", () => {
      // 🛑 ПРОВЕРКА РАЗРЕШЕНИЯ ЭКРАНА (также добавляем сюда)
      if (window.innerWidth <= 860) return;
      // 6. Плавно возвращаем картинку на место при уходе мыши
      image.style.transition = "transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)";
      image.style.transform = "scale(1) rotateX(0deg) rotateY(0deg)";
    });
  });
</script>

<style is:global>
  .global-custom-cursor {
    white-space: pre-line;
    text-align: center;
    position: fixed;
    top: 0;
    left: 0;
    width: 160px;
    height: 160px;
    background-color: #000;
    color: white;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;

    /* Разделяем масштабы на две CSS-переменные */
    --base-scale: 0; /* Масштаб от наведения (0 или 1) */
    --speed-scale: 1; /* Масштаб от скорости (от 0.5 до 1, задается из JS) */

    /* Перемножаем базовый масштаб на масштаб скорости */
    transform: translate(-50%, -50%)
      scale(calc(var(--base-scale) * var(--speed-scale)));

    /* Анимация появления. Мы убрали отсюда transform, 
       так как JS теперь сам плавно рассчитывает размер каждый кадр! */
    transition: opacity 0.3s ease;
  }

  .global-custom-cursor.active {
    opacity: 1;
    --base-scale: 1; /* Круг появляется */
  }
</style>
