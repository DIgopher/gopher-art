---

---

<footer class="container--block grid">
  <h2 class="h1 uppercase cols6 gap">Контакты</h2>
  <div class="footer__content cols3--left">
    <div class="footer__links">
      <p class="subheader">По вопросам<br />сотрудничества</p>
      <a
        href="https://t.me/olga_gopher"
        target="_blank"
        class="footer__link-item"
        rel="noopener noreferrer"
      >
        <span class="footer__icon"
          ><img
            src=`${import.meta.env.BASE_URL}telegram-icon.svg`
            alt="Telegram"
          /></span
        >
        <span class="footer__link-value">@olga_gopher</span>
      </a>
      <a href="mailto:olga.gopher@yandex.ru" class="footer__link-item">
        <span class="footer__icon"
          ><img
            src=`${import.meta.env.BASE_URL}mail-icon.svg`
            alt="Email"
          /></span
        >
        <span class="footer__link-value">olga.gopher@yandex.ru</span>
      </a>
    </div>
  </div>
  <div class="footer__content cols3--right">
    <div class="footer__links">
      <p class="subheader">Рассказываю о жизни <br />и творчестве</p>
      <a
        href="https://t.me/gopher_art"
        target="_blank"
        class="footer__link-item"
        rel="noopener noreferrer"
      >
        <span class="footer__icon"
          ><img
            src=`${import.meta.env.BASE_URL}telegram-icon.svg`
            alt="Telegram"
          /></span
        >
        <span class="footer__link-value">@gopher_art</span>
      </a>
    </div>
    <div class="footer__links">
      <p class="subheader">Другие социальные сети</p>
      <div class="footer__social_row">
        <a
          href="https://vk.ru/gopher_art"
          target="_blank"
          class="footer__link-item"
          rel="noopener noreferrer"
        >
          <span class="footer__icon"
            ><img src=`${import.meta.env.BASE_URL}VK.svg` alt="ВК" /></span
          >
        </a>
        <a
          href="https://www.instagram.com/olja_gopher"
          target="_blank"
          class="footer__link-item"
          rel="noopener noreferrer"
        >
          <span class="footer__icon"
            ><img
              src=`${import.meta.env.BASE_URL}Instagram.svg`
              alt="Instagram"
            /></span
          >
        </a>
        <a
          href="https://www.linkedin.com/in/olga-smirnova-303b74319"
          target="_blank"
          class="footer__link-item"
          rel="noopener noreferrer"
        >
          <span class="footer__icon"
            ><img
              src=`${import.meta.env.BASE_URL}Linkedin.svg`
              alt="LinkedIn"
            /></span
          >
        </a>
        <a
          href="https://x.com/miss_shylka"
          target="_blank"
          class="footer__link-item"
          rel="noopener noreferrer"
        >
          <span class="footer__icon"
            ><img src=`${import.meta.env.BASE_URL}X.svg` alt="X" /></span
          >
        </a>
        <a
          href="https://www.threads.com/@olja_gopher"
          target="_blank"
          class="footer__link-item"
          rel="noopener noreferrer"
        >
          <span class="footer__icon"
            ><img
              src=`${import.meta.env.BASE_URL}Threads.svg`
              alt="Threads"
            /></span
          >
        </a>
      </div>
    </div>
  </div>
</footer>
