---
const { title, slug, date, description } = Astro.props; [cite: 1]
const url = `${import.meta.env.BASE_URL}blog/${slug}/`; [cite: 1]
const formattedDate = date
  ? new Date(date).toLocaleDateString("ru-RU", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
    }) [cite: 2]
  : ""; [cite: 2]
---

<a href={url} class="blog-card blog-card-hover">
  <div class="blog-card__inner">
    <div class="blog-card__top">
      <time class="blog-card__date subheader">{formattedDate}</time>
      <h3 class="blog-card__title h2">{title}</h3>
      {description && <p class="blog-card__description p">{description}</p>}
    </div>
  </div>
</a>

<style>
  /* Стили самой карточки */
  .blog-card-hover {
    cursor: none; /* Скрываем стандартный курсор при наведении */
    display: block; /* чтобы ссылка вела себя как блочный элемент */
    transform: translateZ(0); 
    will-change: transform;
  }
  .blog-card-hover,
  .blog-card-hover * {
    cursor: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII='), none !important; 
    
    /* 2. Запрещаем выделение текста, чтобы не триггерить текстовый курсор */
    -webkit-user-select: none;
    user-select: none;
  }
</style>

<script>
  let cursor = document.querySelector('.global-custom-cursor');
  
  if (!cursor) {
    cursor = document.createElement('div');
    cursor.classList.add('global-custom-cursor');
    cursor.textContent = 'Читать';
    document.body.appendChild(cursor);

    // Координаты мыши
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    
    // Предыдущие координаты (для вычисления скорости)
    let lastX = mouseX;
    let lastY = mouseY;
    
    // Текущий динамический масштаб (для плавности)
    let currentSpeedScale = 1;

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    // Бесконечный цикл отрисовки
    function render() {
      // 1. Вычисляем пройденное расстояние между текущим и прошлым кадром
      const dx = mouseX - lastX;
      const dy = mouseY - lastY;
      const distance = Math.sqrt(dx * dx + dy * dy);

      // 2. Настраиваем чувствительность (чем выше maxDist, тем сильнее нужно дернуть мышью)
      const maxDist = 80; 
      const clampedDist = Math.min(distance, maxDist);

      // 3. Вычисляем целевой масштаб: 1 (в покое) -> 0.5 (при максимальной скорости)
      const targetScale = 1 - (clampedDist / maxDist) * 0.5;

      // 4. Плавная интерполяция (Lerp), чтобы круг не "прыгал" в размерах, а сжимался мягко
      currentSpeedScale += (targetScale - currentSpeedScale) * 0.15;

      // 5. Применяем координаты и передаем масштаб в CSS-переменную
      cursor.style.left = `${mouseX}px`;
      cursor.style.top = `${mouseY}px`;
      cursor.style.setProperty('--speed-scale', currentSpeedScale.toString());

      // Сохраняем текущие координаты для следующего кадра
      lastX = mouseX;
      lastY = mouseY;

      requestAnimationFrame(render);
    }
    
    // Запускаем цикл
    requestAnimationFrame(render);
  }

  // Логика наведения (остается без изменений)
  const cards = document.querySelectorAll('.blog-card-hover');
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      cursor.classList.add('active');
    });
    card.addEventListener('mouseleave', () => {
      cursor.classList.remove('active');
    });
  });
</script>

<style is:global>
  .global-custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 80px;
    height: 80px;
    background-color: #000;
    color: white;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;

    /* Разделяем масштабы на две CSS-переменные */
    --base-scale: 0; /* Масштаб от наведения (0 или 1) */
    --speed-scale: 1; /* Масштаб от скорости (от 0.5 до 1, задается из JS) */

    /* Перемножаем базовый масштаб на масштаб скорости */
    transform: translate(-50%, -50%) scale(calc(var(--base-scale) * var(--speed-scale)));
    
    /* Анимация появления. Мы убрали отсюда transform, 
       так как JS теперь сам плавно рассчитывает размер каждый кадр! */
    transition: opacity 0.3s ease;
  }

  .global-custom-cursor.active {
    opacity: 1;
    --base-scale: 1; /* Круг появляется */
  }
</style>