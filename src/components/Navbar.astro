---
const { variant = "none" } = Astro.props;
---

<nav class="navbar">
  <div class="navbar-wrapper cols4">
    <div class="navbar-container">
      <a class="navbar__logo" href={`${import.meta.env.BASE_URL}`}>
        <img src={`${import.meta.env.BASE_URL}logo.svg`} alt="Logo" />
      </a>

      <div class="navbar__wrapper">
        <input
          id="navbar-toggle"
          class="navbar__toggle"
          type="checkbox"
          aria-label="Toggle navigation"
        />
        <label
          class="navbar__burger"
          for="navbar-toggle"
          aria-label="Toggle navigation"
        >
          <span></span>
          <span></span>
          <span></span>
        </label>

        <ul class="navbar__menu">
          <li class="navbar__item">
            <a
              class="navbar__link"
              href={`${import.meta.env.BASE_URL}about/`}
              data-text="Обо мне">Обо мне</a
            >
          </li>
          <li class="navbar__item">
            <a
              class="navbar__link"
              href={`${import.meta.env.BASE_URL}portfolio/`}
              data-text="Портфолио">Портфолио</a
            >
          </li>
          <li class="navbar__item">
            <a
              class="navbar__link"
              href={`${import.meta.env.BASE_URL}blog/`}
              data-text="Блог">Блог</a
            >
          </li>
          <li class="navbar__item">
            <a
              class="navbar__link"
              href={`${import.meta.env.BASE_URL}comic/`}
              data-text="Комикс">Комикс</a
            >
          </li>
        </ul>
        <div class="navbar__item--extra" style={`display:${variant}`}>
          <slot />
        </div>
      </div>
    </div>
  </div>
</nav>
