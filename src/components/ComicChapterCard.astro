---
import { Image } from "astro:assets";

const { comic, chapter, label, description, preview } = Astro.props;

const chapterUrl = `/comic/${encodeURIComponent(comic)}/${encodeURIComponent(chapter)}/`;
---

<article class="comic-chapter-preview">
  <a
    class="comic-chapter-preview__imageLink small-gap"
    href={chapterUrl}
    aria-label={label}
  >
    {
      preview ? (
        <Image
          src={preview}
          alt={`Превью ${label}`}
          loading="lazy"
          class="comic-chapter-preview__image"
        />
      ) : (
        <div class="comic-chapter-preview__empty">Нет превью</div>
      )
    }
  </a>

  <div class="comic-chapter-preview__info">
    <p class="h3 small-gap text-center">{label}</p>
    {description && <p class="p--small grey text-center">{description}</p>}
  </div>
</article>
